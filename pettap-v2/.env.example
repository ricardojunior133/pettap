# Coming Soon production gate. Production is protected by default; set false only
# when the full public PetTap application is intentionally being restored.
PETTAP_COMING_SOON_MODE=true

# Keep disabled until a real waitlist endpoint is configured.
NEXT_PUBLIC_WAITLIST_ENABLED=false
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Public launch contact and confirmed public social profile.
NEXT_PUBLIC_CONTACT_EMAIL=hello@pettap.co.uk
NEXT_PUBLIC_INSTAGRAM_URL=

# Supabase backend. Add real values only to .env.local or the Vercel environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require
NEXT_PUBLIC_SITE_URL=https://pettap.co.uk

# Stripe remains optional until the private Checkout sprint is explicitly enabled.
# Never use NEXT_PUBLIC_ for either secret and never commit real values.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email. These remain server-only and are used by Resend only in
# production. The development provider writes messages to the local console.
RESEND_API_KEY=
EMAIL_FROM=hello@pettap.co.uk
EMAIL_REPLY_TO=support@pettap.co.uk
EMAIL_SUPPORT=support@pettap.co.uk

# Observability is deliberately provider-neutral. Configure providers only in
# Vercel production, never in client-exposed NEXT_PUBLIC_ variables.
SENTRY_DSN=
VERCEL_ANALYTICS_ENABLED=false

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This server-only key encrypts medical_information.encrypted_payload.
MEDICAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
