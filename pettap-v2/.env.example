# Coming Soon production gate. Production is protected by default; set false only
# when the full public PetTap application is intentionally being restored.
PETTAP_COMING_SOON_MODE=true

# Keep disabled until a real waitlist endpoint is configured.
NEXT_PUBLIC_WAITLIST_ENABLED=false
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Public launch contact and confirmed public social profile.
NEXT_PUBLIC_CONTACT_EMAIL=hello@pettap.co.uk
NEXT_PUBLIC_INSTAGRAM_URL=

# Supabase backend. Add real values only to .env.local or the Vercel environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require
NEXT_PUBLIC_SITE_URL=https://pettap.co.uk
