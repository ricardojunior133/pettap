{
    "compilerOptions":  {
                            "target":  "ES2017",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "incremental":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ]
                                      },
                            "skipLibCheck":  true,
                            "allowJs":  true
                        },
    "include":  [
                    "next-env.d.ts",
                    "app/layout.tsx",
                    "app/page.tsx",
                    "app/event/**/*.ts",
                    "app/event/**/*.tsx",
                    "app/admin/event-demo/**/*.ts",
                    "app/admin/event-demo/**/*.tsx",
                    "app/api/admin/event-demo/**/*.ts",
                    "app/api/internal/contact-request-notifications/**/*.ts",
                    "components/coming-soon/PremiumComingSoon.tsx",
                    "components/event-demo/**/*.ts",
                    "components/event-demo/**/*.tsx",
                    "components/ui/button.tsx",
                    "components/ui/Card.tsx",
                    "features/event-demo/**/*.ts",
                    "features/event-demo/**/*.tsx",
                    "features/admin/constants/access.ts",
                    "features/admin/types/admin.ts",
                    "features/admin/repositories/admin-repository.ts",
                    "features/admin/services/admin-authorization-service.ts",
                    "features/admin/services/admin-audit-service.ts",
                    "features/owner/repositories/owner-repository.ts",
                    "features/owner/services/profile-service.ts",
                    "lib/auth/require-admin.ts",
                    "lib/backend/db.ts",
                    "lib/backend/env.ts",
                    "lib/backend/public-env.ts",
                    "lib/backend/auth/get-current-user.ts",
                    "lib/backend/supabase/server.ts",
                    "lib/backend/supabase/proxy.ts",
                    "lib/security/rate-limit.ts",
                    "lib/security/same-origin.ts",
                    "lib/utils.ts",
                    "db/schema/admin.ts",
                    "db/schema/core.ts",
                    "db/schema/event-demo.ts",
                    "db/schema/index.ts",
                    "proxy.ts",
                    "scripts/event-demo-create-tag.ts",
                    "scripts/production-migration-0018-preflight.ts",
                    "scripts/temporary-migration-0018-postflight.ts",
                    "scripts/temporary-isolated-drizzle-config.ts",
                    "tests/event-demo-*.test.ts",
                    "tests/server-only.ts",
                    "vitest.config.ts",
                    "next.config.ts",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts",
                    "app/login/page.tsx",
                    "components/auth/AuthForm.tsx",
                    "features/auth/actions/auth-actions.ts",
                    "features/auth/schemas/auth.ts",
                    "app/account/**/*.ts",
                    "app/account/**/*.tsx",
                    "features/account/**/*.ts",
                    "features/account/**/*.tsx",
                    "features/commerce/repositories/order-repository.ts",
                    "features/commerce/services/commerce-account-service.ts",
                    "features/commerce/services/order-read-service.ts",
                    "features/commerce/repositories/customer-address-repository.ts",
                    "features/commerce/services/customer-address-service.ts",
                    "features/commerce/schemas/address.ts",
                    "features/commerce/types/commerce.ts",
                    "db/schema/commerce.ts",
                    "tests/customer-orders-read.test.ts",
                    "tests/customer-order-details.test.ts",
                    "tests/customer-profile.test.ts",
                    "tests/customer-notifications.test.ts",
                    "features/account/repositories/customer-notification-repository.ts",
                    "features/account/services/customer-notification-service.ts",
                    "features/account/actions/customer-notification-actions.ts"
                    ,"features/contact-request-notifications/**/*.ts"
                    ,"tests/contact-request-notification*.test.ts"
                    ,"features/account/repositories/customer-pet-foundation-repository.ts"
                    ,"features/account/repositories/customer-tag-foundation-repository.ts"
                    ,"features/account/repositories/customer-tag-activation-foundation-repository.ts"
                    ,"features/account/services/customer-pet-foundation-service.ts"
                    ,"features/account/services/customer-tag-foundation-service.ts"
                    ,"tests/customer-nfc-pets-foundation.test.ts"
                ],
    "exclude":  [
                    "node_modules",
                    ".next"
                ]
}
